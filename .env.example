# токен бота от @BotFather
BOT_TOKEN=123456:ABC...
# твой числовой Telegram ID (узнать: @userinfobot)
ADMIN_ID=123456789
# публичный адрес подписки: https, без слэша в конце (тот же домен, что в Caddyfile)
BASE_URL=https://sub.example.com
# кому клиенты пишут про оплату
PAY_CONTACT=@mannapov_ulugbek
# порт внутри контейнера/без Docker
PORT=8080
# Путь к базе. В Docker ставь /data/vpn.db и подключи volume на /data (иначе база пропадёт при пересборке)
DB_PATH=/data/vpn.db

# --- Если платформа не умеет монтировать файлы (Railway, Coolify, Dokploy и т.п), передай их переменными ---
# список серверов: base64 -w0 servers.json
# SERVERS_JSON=eyJ...
# приватный ключ SSH: base64 -w0 ssh/vpnbot
# SSH_KEY_B64=LS0tLS1...
